{
  "name": "js-spreadsheet",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/lib/react.js",
  "module": "./dist/lib/react.js",
  "types": "./dist/types/entry/react.d.ts",
  "typesVersions": {
    "*": {
      "core": ["dist/types/entry/core.d.ts"],
      "react": ["dist/types/entry/react.d.ts"],
      "connectors/google": ["dist/types/entry/google.d.ts"]
    }
  },
  "exports": {
    ".": { "types": "./dist/types/entry/react.d.ts", "import": "./dist/lib/react.js" },
    "./core": { "types": "./dist/types/entry/core.d.ts", "import": "./dist/lib/core.js" },
    "./react": { "types": "./dist/types/entry/react.d.ts", "import": "./dist/lib/react.js" },
    "./connectors/google": { "types": "./dist/types/entry/google.d.ts", "import": "./dist/lib/connectors/google.js" },
    "./styles.css": "./dist/lib/styles.css"
  },
  "files": ["dist/lib", "dist/types", "README.md", "LICENSE"],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "build": "pnpm run typecheck && pnpm run build:app",
    "build:app": "vite build --outDir dist/app --emptyOutDir",
    "build:lib": "tsc -p tsconfig.build.json && vite build --config vite.lib.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hyperformula": "^3.3.0",
    "lucide-react": "^1.21.0"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fast-check": "4.9.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
